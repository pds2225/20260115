# ─────────────────────────────────────────────────────────────────────────────
# VALUE-UP AI — 환경변수 설정 파일
# 이 파일을 복사하여 .env 로 저장하고 실제 키를 입력하세요.
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════════════════════
# ✅ 지금 당장 작동하는 것 (실제 확인 완료)
# ══════════════════════════════════════════════════════════════════════════════

# [Layer 4] Hunter.io — 도메인으로 담당자 이메일 즉시 확보
# ✅ 확인: wangfoodusa.com → 10명 이메일 즉시 확보
# 무료 티어: 월 25건 검색  |  유료: $49/월 (500건)
# 발급: https://hunter.io/api-documentation/v2
HUNTER_IO_API_KEY=

# [발송] Gmail SMTP — 아웃리치 이메일 실제 발송
# ✅ 확인: ImportGenius·TradeInt·Panjiva 3개사 초안 실제 발송 성공
# Gmail 앱 비밀번호: https://myaccount.google.com/security → 앱 비밀번호
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# [Layer 1] KOTRA Open API — 수출유망추천정보 실시간 조회
# ✅ 실제 연동 완료 (2,100건 수집됨)
# 발급: https://apis.data.go.kr (공공데이터포털)
KOTRA_API_KEY=


# ══════════════════════════════════════════════════════════════════════════════
# ⚠️  API 키 보유 시 자동으로 전환되는 유료 소스
# ══════════════════════════════════════════════════════════════════════════════

# [Layer 1] Volza — 세관 B/L 기반 실시간 수출입 데이터 (현재: CSV Seed DB 폴백)
# 키 설정 시: 전 세계 세관 데이터 실시간 조회 가능
# 가격: $99/월~ | https://www.volza.com/api
VOLZA_API_KEY=

# [Layer 1] ImportGenius — B/L 바이어 데이터베이스
# 가격: $349/월~ | https://www.importgenius.com/api
IMPORTGENIUS_API_KEY=

# [Layer 4] Apollo.io — 담당자 이메일 + 전화번호 DB (현재: 패턴 추정 폴백)
# 무료 티어: 월 50건  |  유료: $49/월~
# https://developer.apollo.io
APOLLO_API_KEY=

# [Layer 4] Clay.com — 담당자 인텔리전스 플랫폼 (현재: 비활성)
# https://www.clay.com/api
CLAY_API_KEY=

# [Layer 4] Lusha — B2B 연락처 DB (현재: 비활성)
# https://www.lusha.com/api
LUSHA_API_KEY=

# [Layer 1] Snov.io — 이메일 발굴 + 검증 (현재: 비활성)
SNOVIO_CLIENT_ID=
SNOVIO_CLIENT_SECRET=

# [Layer 1] TradeImex API — 세관 수입업체 검색 (현재: CSV 폴백)
# ✅ 확인: 김치 수입업체 61개 중 상위 10개 확보 (무료 검색 기준)
# https://www.tradeimex.in/api
TRADEIMEX_API_KEY=


# ══════════════════════════════════════════════════════════════════════════════
# ❌ 연동 불가 (무료 대안 사용 중)
# ══════════════════════════════════════════════════════════════════════════════

# [Layer 2] Coface API — 신용등급 조회 (현재: CSV DB로 대체)
# 현재: country_credit_db.csv (23개국 Coface 등급 수동 입력)
COFACE_API_KEY=

# [Layer 2] D&B API — 기업 신용 정보 (현재: 미연동)
DNB_API_KEY=

# [Layer 2] K-SURE API — 무역보험 바이어 DB (현재: 미연동)
KSURE_API_KEY=


# ══════════════════════════════════════════════════════════════════════════════
# AI 이메일 개인화 (선택)
# ══════════════════════════════════════════════════════════════════════════════

# OpenAI GPT-4o — 이메일 고도 개인화 (현재: 템플릿 방식으로 작동)
# 키 설정 시: 거래 이력 기반 맞춤 이메일 자동 생성
OPENAI_API_KEY=


# ══════════════════════════════════════════════════════════════════════════════
# 서버 설정
# ══════════════════════════════════════════════════════════════════════════════

# FastAPI 서버
HOST=0.0.0.0
PORT=8000
DEBUG=false
